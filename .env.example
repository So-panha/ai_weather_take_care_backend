PROJECT_NAME="AI Weather Care"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
# Use localhost. Remember docker sets the env to "db" when running in container.
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=weather_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# JWT
SECRET_KEY="YOUR_SUPER_SECRET_KEY_CHANGEME"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (for Rate Limiting)
REDIS_URL="redis://localhost:6379/0"

# OpenWeatherMap API
OPENWEATHERMAP_API_KEY="your_open_weather_map_api_key_here"

# Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"

# Email settings
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=test@example.com
SMTP_PASSWORD=test
EMAILS_FROM_EMAIL=info@example.com
